# Copy to .secrets.env (gitignored, chmod 600) and fill in. Template only — no values.
# One file for everything the admin tooling needs. See docs ops manual §10.
# Load for a shell:  set -a; source .secrets.env; set +a
# ops-tools/*.py read it automatically (host-aware).
# Every KEY below doubles as a remote-command token: @@KEY@@ (shell-quoted at
# substitution), so values never touch a command line or a doc — e.g.
#   python3 ops-tools/runcmd.py pi0 pi0 'curl -s https://api.telegram.org/bot@@TELEGRAM_BOT_TOKEN@@/getMe'

# --- Node SSH (replace with SSH keys when migrated; then delete these) ---
PI_PASS=
TX2_PASS=

# --- Cluster services ---
PGPASSWORD=
GRAFANA_ADMIN_PASSWORD=
FRED_API_KEY=

# --- Out-of-band (fill in by hand; not recoverable from the repo) ---
PIHOLE_ADMIN_PASSWORD=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- LLM API (ML-7, planned): out-of-band; also created as a cluster Secret, never in git ---
LLM_PROVIDER=            # nvidia (ADR 0022)
LLM_API_KEY=             # nvapi-… — never in git or chat. Copied into the shared gateway with
                         # ../llm-gateway/ops/set-provider-key.sh nvidia-nim-api-key .secrets.env LLM_API_KEY
                         # (models + failover are configured in the gateway, not here)
