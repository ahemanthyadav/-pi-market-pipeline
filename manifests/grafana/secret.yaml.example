# Grafana admin credentials. Generated 2026-09-30 with `openssl rand -base64 18`.
# Reach Grafana at http://<pi3-tailnet-or-lan-ip>:3000 via kubectl port-forward
# (Phase 7 notes) — tailnet-only, never exposed publicly.
apiVersion: v1
kind: Secret
metadata:
  name: grafana-admin
  namespace: market-data
type: Opaque
stringData:
  admin-user: <changeme>
  admin-password: <changeme>
