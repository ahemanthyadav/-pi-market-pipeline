# Postgres superuser password. Generated 2026-09-29 with `openssl rand -base64 24`.
# Rotate by editing `password` and restarting the StatefulSet.
# (Homelab-grade secret management — see Phase 8 hardening notes.)
apiVersion: v1
kind: Secret
metadata:
  name: timescaledb-auth
  namespace: market-data
type: Opaque
stringData:
  username: <changeme>
  password: <changeme>
